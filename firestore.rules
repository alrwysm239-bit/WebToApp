rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() &&
             request.auth.token.email_verified == true &&
             request.auth.token.email == 'alrwysm239@gmail.com';
    }

    function isAdmin() {
      return isBootstrappedAdmin() ||
             (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt']) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120));
    }

    function isValidAdminSettings(data) {
      return data.keys().hasAll(['ownerUid', 'ownerEmail', 'aiEnabled', 'defaultModel', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly([
               'ownerUid',
               'ownerEmail',
               'aiEnabled',
               'proxyUrl',
               'geminiApiKey',
               'defaultModel',
               'passwordSalt',
               'passwordHash',
               'createdAt',
               'updatedAt'
             ]) &&
             data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
             data.ownerEmail is string && data.ownerEmail.size() >= 3 && data.ownerEmail.size() <= 200 &&
             data.aiEnabled is bool &&
             data.defaultModel is string && data.defaultModel.size() >= 1 && data.defaultModel.size() <= 80 &&
             (!('proxyUrl' in data) || (data.proxyUrl is string && data.proxyUrl.size() <= 500)) &&
             (!('geminiApiKey' in data) || (data.geminiApiKey is string && data.geminiApiKey.size() <= 300)) &&
             (!('passwordSalt' in data) || (data.passwordSalt is string && data.passwordSalt.size() <= 128)) &&
             (!('passwordHash' in data) || (data.passwordHash is string && data.passwordHash.size() <= 128));
    }

    function isValidPublicAiConfig(data) {
      return data.keys().hasAll(['aiEnabled', 'defaultModel', 'updatedBy', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['aiEnabled', 'proxyUrl', 'defaultModel', 'updatedBy', 'createdAt', 'updatedAt']) &&
             data.aiEnabled is bool &&
             data.defaultModel is string && data.defaultModel.size() >= 1 && data.defaultModel.size() <= 80 &&
             data.updatedBy is string && data.updatedBy.size() >= 1 && data.updatedBy.size() <= 128 &&
             (!('proxyUrl' in data) || (data.proxyUrl is string && data.proxyUrl.size() <= 500));
    }

    match /admins/{adminUid} {
      allow get: if isSignedIn() && isValidId(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create: if isBootstrappedAdmin() &&
                       isValidId(adminUid) &&
                       isValidAdminUser(incoming()) &&
                       incoming().uid == adminUid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isBootstrappedAdmin() &&
                       isValidId(adminUid) &&
                       isValidAdminUser(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if false;
    }

    match /admin_settings/{docId} {
      allow get: if isAdmin() && isValidId(docId) && docId == 'gemini';
      allow list: if false;
      allow create: if isAdmin() &&
                       isValidId(docId) &&
                       docId == 'gemini' &&
                       isValidAdminSettings(incoming()) &&
                       incoming().ownerUid == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isAdmin() &&
                       isValidId(docId) &&
                       docId == 'gemini' &&
                       isValidAdminSettings(incoming()) &&
                       incoming().ownerUid == existing().ownerUid &&
                       incoming().ownerEmail == existing().ownerEmail &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'aiEnabled',
                         'proxyUrl',
                         'geminiApiKey',
                         'defaultModel',
                         'passwordSalt',
                         'passwordHash',
                         'updatedAt'
                       ]);
      allow delete: if false;
    }

    match /public_ai_config/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && docId == 'runtime';
      allow list: if false;
      allow create: if isAdmin() &&
                       isValidId(docId) &&
                       docId == 'runtime' &&
                       isValidPublicAiConfig(incoming()) &&
                       incoming().updatedBy == request.auth.uid &&
                       incoming().createdAt is timestamp && incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time;
      allow update: if isAdmin() &&
                       isValidId(docId) &&
                       docId == 'runtime' &&
                       isValidPublicAiConfig(incoming()) &&
                       incoming().updatedBy == request.auth.uid &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp && incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'aiEnabled',
                         'proxyUrl',
                         'defaultModel',
                         'updatedBy',
                         'updatedAt'
                       ]);
      allow delete: if false;
    }
  }
}
